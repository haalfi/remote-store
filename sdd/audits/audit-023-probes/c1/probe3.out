===== runtime sync =====
[read_bytes('x//missing')  (kernel probe NotFound)] -> raised NotFound path='x/missing'
[get_file_info('./x/missing')] -> raised NotFound path='x/missing'
[delete('d//')  (folder -> InvalidPath)] -> raised InvalidPath path='d'
[write('f/', b'') no overwrite (AlreadyExists)] -> raised AlreadyExists path='f'
[get_folder_info('./f')  (file -> InvalidPath)] -> raised InvalidPath path='f'
[delete_folder('nope//')  (NotFound)] -> raised NotFound path='nope'
[read_bytes('./')  (root refusal)] -> raised InvalidPath path='./'
[read_bytes('a/../b')  (key refusal)] -> raised InvalidPath path='a/../b'
[move('./missing', 'z')] -> raised NotFound path='missing'
