                       LOC=['d/.h.csv', 'd/a.csv', 'd/e/c.csv', 'd/e/f/g.csv', 'd/x/b.csv']
'd**'                  MEM=['d/.h.csv', 'd/a.csv', 'd/b.CSV', 'd/e/c.csv', 'd/e/f/g.csv', 'd/x/b.csv']
                       LOC=[]   <<< DIFF
'd/e**'                MEM=['d/e/c.csv', 'd/e/f/g.csv']
                       LOC=[]   <<< DIFF
'a**'                  MEM=['a-b', 'a.csv', 'a]b', 'abc']
                       LOC=['a-b', 'a.csv', 'a]b', 'abc']
'**/'                  MEM=[]
                       LOC=[]
'd/*/'                 MEM=[]
                       LOC=[]
'd/'                   MEM=[]
                       LOC=[]
'/d/*.csv'             MEM=['d/.h.csv', 'd/a.csv']
                       LOC=['d/.h.csv', 'd/a.csv']
''                     MEM=[]
                       LOC=[]
'.'                    MEM=[]
                       LOC=[]
'/'                    MEM=[]
                       LOC=[]
'd/a.csv'              MEM=['d/a.csv']
                       LOC=['d/a.csv']
'f.txt/*'              MEM=[]
                       LOC=[]
'f.txt/**'             MEM=[]
                       LOC=[]
'nope/*.csv'           MEM=[]
                       LOC=[]
'nope/**'              MEM=[]
                       LOC=[]
'*.CSV'                MEM=[]
                       LOC=[]
'd/[!a]*'              MEM=['d/.h.csv', 'd/b.CSV']
                       LOC=['d/.h.csv', 'd/b.CSV']
'd[!x]e/c.csv'         MEM=['d/e/c.csv']
                       LOC=[]   <<< DIFF
'a[!x]b'               MEM=['a-b', 'a]b']
                       LOC=['a-b', 'a]b']
'd/[a-b].csv'          MEM=['d/a.csv']
                       LOC=['d/a.csv']
'[]]*'                 MEM=[]
                       LOC=[]
'a[]]b'                MEM=['a]b']
                       LOC=['a]b']
'[!]]*'                MEM=['.hidden.csv', 'a-b', 'a.csv', 'a]b', 'abc', 'f.txt']
                       LOC=['.hidden.csv', 'a-b', 'a.csv', 'a]b', 'abc', 'f.txt']
'[\\]'                 MEM=PatternError: bad escape \Z at position 4
                       LOC=[]   <<< DIFF
'[a&&b]'               MEM=[] W:FutureWarning
                       LOC=[]
'[[:alpha:]]*'         MEM=['a]b'] W:FutureWarning
                       LOC=['a]b']
'd/*/c.csv'            MEM=['d/e/c.csv']
                       LOC=['d/e/c.csv']
'*/*/c.csv'            MEM=['d/e/c.csv']
                       LOC=['d/e/c.csv']
