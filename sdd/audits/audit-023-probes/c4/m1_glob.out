mem GLOB False local GLOB True
'*'                    MEM=['.hidden.csv', 'a-b', 'a.csv', 'a]b', 'abc', 'f.txt']
                       LOC=['.hidden.csv', 'a-b', 'a.csv', 'a]b', 'abc', 'f.txt']
'*.csv'                MEM=['.hidden.csv', 'a.csv']
                       LOC=['.hidden.csv', 'a.csv']
'**'                   MEM=['.dot/z.csv', '.hidden.csv', 'a-b', 'a.csv', 'a]b', 'abc', 'd/.h.csv', 'd/a.csv', 'd/b.CSV', 'd/e/c.csv', 'd/e/f/g.csv', 'd/x/b.csv', 'f.txt', 'x/y']
                       LOC=['.dot/z.csv', '.hidden.csv', 'a-b', 'a.csv', 'a]b', 'abc', 'd/.h.csv', 'd/a.csv', 'd/b.CSV', 'd/e/c.csv', 'd/e/f/g.csv', 'd/x/b.csv', 'f.txt', 'x/y']
