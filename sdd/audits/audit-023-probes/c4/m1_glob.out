                       LOC=['.dot/z.csv', '.hidden.csv', 'a.csv', 'd/.h.csv', 'd/a.csv', 'd/e/c.csv', 'd/e/f/g.csv', 'd/x/b.csv']
'd/**'                 MEM=['d/.h.csv', 'd/a.csv', 'd/b.CSV', 'd/e/c.csv', 'd/e/f/g.csv', 'd/x/b.csv']
                       LOC=['d/.h.csv', 'd/a.csv', 'd/b.CSV', 'd/e/c.csv', 'd/e/f/g.csv', 'd/x/b.csv']
